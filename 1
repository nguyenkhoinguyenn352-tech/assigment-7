# Exercise 1: Season by month number

# Define seasons as a tuple
seasons = ("spring", "summer", "autumn", "winter")

# Ask for month number
month = int(input("Enter the number of a month (1-12): "))

# Determine the season
if month in (3, 4, 5):
    season = seasons[0]
elif month in (6, 7, 8):
    season = seasons[1]
elif month in (9, 10, 11):
    season = seasons[2]
else:
    season = seasons[3]

print(f"The month {month} is in {season}.")
